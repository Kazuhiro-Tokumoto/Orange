# Flags for the oag-node service. Copy to /etc/default/oag-node and edit.
#
# --datadir is set by the unit file (/var/lib/oag-node). Everything else
# goes here. Pick ONE of the three lines below and leave the rest commented.

# --- full node --------------------------------------------------------
#
# Keeps every block and can hand any of them to anyone. This is what the
# network needs most of; if you have the disk, run this.
OAG_FLAGS="--network mainnet"

# --- pruned full node -------------------------------------------------
#
# Validates exactly as strictly as the line above -- same UTXO set, same
# checks -- but throws away block bodies older than the window and can
# only serve recent ones. Disk stops growing.
#
# --prune on its own keeps 4320 blocks (about three days). Give it a
# number to choose your own; 144 is the floor.
#
#OAG_FLAGS="--network mainnet --prune"

# --- light node -------------------------------------------------------
#
# Checks headers itself and scans blocks for your addresses, then throws
# the blocks away. It keeps no UTXO set and serves nothing, so it does not
# help the network -- it is for watching your own coins on a small machine.
#
# Repeat --watch for each address. Adding one later restarts the scan from
# the beginning, which is the honest thing to do: blocks already passed are
# never looked at again.
#
#OAG_FLAGS="--network mainnet --light --watch oag1..."
